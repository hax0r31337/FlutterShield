+        environment.fileSystem.path.join(environment.flutterRootDir.path, flutterShieldEntrypoint),
+      ),
+      inputDill.path,
+      hardenedDill.path,
+    ];
+    environment.logger.printTrace('Running FlutterShield: ${command.join(' ')}');
+
+    final ProcessResult result = await environment.processManager.run(
+      command,
+      environment: shieldEnvironment,
+    );
+    environment.logger.printTrace(result.stdout.toString().trim());
+    if (result.exitCode != 0) {
+      throw Exception('FlutterShield exited with code ${result.exitCode}.\n${result.stderr}');
+    }
+    if (!hardenedDill.existsSync()) {
+      throw Exception('FlutterShield did not write the processed dill to ${hardenedDill.path}.');
+    }
+
+    hardenedDill.renameSync(inputDill.path);
