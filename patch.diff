+  /// Runs the FlutterShield tool over the kernel snapshot at [dillPath],
+  /// replacing it with the processed one.
+  ///
+  /// The tool is invoked with the input dill as the first argument and the
+  /// destination of the processed dill as the second, and is expected to write
+  /// the latter. It is run here rather than as a separate [Target] so that
+  /// every consumer of the snapshot sees the processed dill, whichever AOT
+  /// target the platform uses.
+  Future<void> _runFlutterShield(Environment environment, String dillPath) async {
+    final File inputDill = environment.fileSystem.file(dillPath);
+    final File hardenedDill = environment.buildDir.childFile(hardenedDillName);
+
+    final command = <String>[
+      environment.artifacts.getArtifactPath(Artifact.engineDartBinary),
+      'run',
+      environment.fileSystem.path.normalize(
+        environment.fileSystem.path.join(environment.flutterRootDir.path, flutterShieldEntrypoint),
+      ),
+      inputDill.path,
+      hardenedDill.path,
+    ];
+    environment.logger.printTrace('Running FlutterShield: ${command.join(' ')}');
+
+    final ProcessResult result = await environment.processManager.run(command);
+    if (result.exitCode != 0) {
+      throw Exception('FlutterShield exited with code ${result.exitCode}.\n${result.stderr}');
+    }
+    if (!hardenedDill.existsSync()) {
+      throw Exception('FlutterShield did not write the processed dill to ${hardenedDill.path}.');
+    }
+
+    hardenedDill.renameSync(inputDill.path);
   }
 
