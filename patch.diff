+  /// Runs the FlutterShield tool over the kernel snapshot at [dillPath],
+  /// replacing it with the processed one.
+  ///
+  /// The tool is invoked with the input dill as the first argument and the
+  /// destination of the processed dill as the second, and is expected to write
+  /// the latter. It is run here rather than as a separate [Target] so that
+  /// every consumer of the snapshot sees the processed dill, whichever AOT
+  /// target the platform uses.
+  ///
+  /// It is configured through the `FS_`-prefixed entries of [dartDefines],
+  /// which are handed to it as environment variables; dart defines themselves
+  /// only reach the compiled program, not the processes of the build.
+  Future<void> _runFlutterShield(
+    Environment environment,
+    String dillPath,
+    List<String> dartDefines,
+  ) async {
+    final shieldEnvironment = <String, String>{};
+    for (final String define in dartDefines) {
+      if (!define.startsWith(flutterShieldDefinePrefix)) {
+        continue;
+      }
+      final int separator = define.indexOf('=');
+      if (separator > 0) {
+        shieldEnvironment[define.substring(0, separator)] = define.substring(separator + 1);
+      }
+    }
